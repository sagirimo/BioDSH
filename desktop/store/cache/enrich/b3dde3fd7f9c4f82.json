[{"id": "bio-workflows-clinical-trial-pipeline", "title_zh": "临床试验全流程分析", "summary_zh": "从数据整理到符合监管的报告，涵盖主要分析、缺失数据处理和亚组分析，适合需要完整临床试验分析的场景。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["临床试验", "数据分析", "监管合规"], "level": "专家"}, {"id": "bio-workflows-clip-pipeline", "title_zh": "CLIP-seq 结合位点分析", "summary_zh": "从测序数据到结合位点、基序和差异结合，适用于研究 RNA 结合蛋白的相互作用。", "domain": "表观与调控", "subcategory": "基因调控网络与转录因子", "tags_zh": ["RNA结合蛋白", "结合位点", "CLIP-seq"], "level": "进阶"}, {"id": "bio-workflows-cnv-pipeline", "title_zh": "拷贝数变异分析流程", "summary_zh": "从比对文件到注释的拷贝数变异，支持体细胞和胚系变异，适用于肿瘤或遗传病研究。", "domain": "基因组与变异", "subcategory": "结构变异与拷贝数", "tags_zh": ["拷贝数变异", "肿瘤", "遗传病"], "level": "进阶"}, {"id": "bio-workflows-crispr-editing-pipeline", "title_zh": "CRISPR 编辑实验设计", "summary_zh": "从靶基因到可验证的构建体，涵盖引导RNA设计、脱靶评估和编辑方式选择，适用于设计敲除或敲入实验。", "domain": "基因组与变异", "subcategory": "基因编辑与 CRISPR", "tags_zh": ["CRISPR", "实验设计", "基因编辑"], "level": "进阶"}, {"id": "bio-workflows-crispr-screen-pipeline", "title_zh": "CRISPR 筛选分析流程", "summary_zh": "从测序数据到关键基因，包括文库质控、命中基因识别和拷贝数校正，适用于全基因组或靶向筛选。", "domain": "基因组与变异", "subcategory": "基因编辑与 CRISPR", "tags_zh": ["CRISPR筛选", "命中基因", "质控"], "level": "专家"}, {"id": "bio-workflows-cytometry-pipeline", "title_zh": "流式细胞术数据分析", "summary_zh": "从原始数据到细胞群体差异分析，支持流式、光谱和质谱流式，适用于免疫细胞分型等研究。", "domain": "代谢与其他组学", "subcategory": "流式细胞", "tags_zh": ["流式细胞", "细胞分型", "差异分析"], "level": "进阶"}, {"id": "bio-workflows-edna-pipeline", "title_zh": "环境 DNA 宏条形码分析", "summary_zh": "从扩增子测序到群落生态分析，涵盖去噪、污染控制和物种鉴定，适用于环境监测和生物多样性研究。", "domain": "微生物与免疫", "subcategory": "宏基因组与微生物组", "tags_zh": ["环境DNA", "宏条形码", "生物多样性"], "level": "进阶"}, {"id": "bio-workflows-expression-to-pathways", "title_zh": "表达差异到通路富集", "summary_zh": "从差异表达结果到功能富集分析，支持 ORA 和 GSEA，适用于解释基因列表的生物学意义。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["通路富集", "GSEA", "功能注释"], "level": "入门"}, {"id": "bio-workflows-fastq-to-variants", "title_zh": "测序数据到变异检测", "summary_zh": "从原始测序数据到过滤和注释的变异文件，涵盖比对、变异调用和质控，适用于全基因组或外显子组测序