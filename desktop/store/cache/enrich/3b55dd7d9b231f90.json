[{"id": "samtools-bam-processing", "title_zh": "BAM 文件处理与质控", "summary_zh": "用于处理测序比对文件，进行排序、索引、过滤和质控，是变异检测和 peak calling 前的必备步骤。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["BAM处理", "质控", "比对文件"], "level": "入门"}, {"id": "star-rna-seq-aligner", "title_zh": "RNA-seq 剪接感知比对", "summary_zh": "将 RNA 测序读段比对到基因组，识别剪接位点，输出 BAM 文件和剪接位点表，用于后续差异表达和变异检测。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["RNA-seq", "比对", "剪接位点"], "level": "进阶"}, {"id": "bakta-genome-annotation", "title_zh": "细菌基因组快速注释", "summary_zh": "快速注释细菌和古菌基因组，识别基因、RNA 和 CRISPR 等元件，输出 NCBI 兼容的多种格式文件。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["细菌", "基因组注释", "NCBI兼容"], "level": "进阶"}, {"id": "prokka-genome-annotation", "title_zh": "原核基因组注释", "summary_zh": "注释细菌、古菌和病毒的基因组，识别基因和功能元件，输出 GFF3 等格式，适合常规原核注释。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["原核", "注释", "GFF3"], "level": "进阶"}, {"id": "roary-pangenome", "title_zh": "细菌泛基因组分析", "summary_zh": "基于多个细菌基因组注释，计算核心基因和可变基因，构建基因存在/缺失矩阵，用于比较基因组研究。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["泛基因组", "细菌", "比较基因组"], "level": "进阶"}, {"id": "arboreto-grn-inference", "title_zh": "基因调控网络推断", "summary_zh": "从基因表达数据推断转录因子与靶基因的调控关系，适用于单细胞数据，是 SCENIC 的核心组件。", "domain": "表观与调控", "subcategory": "基因调控网络与转录因子", "tags_zh": ["调控网络", "转录因子", "单细胞"], "level": "进阶"}, {"id": "biopython-molecular-biology", "title_zh": "分子生物学工具包", "summary_zh": "处理序列、文件格式转换、数据库查询和 BLAST 自动化，适合批量处理和自定义流程开发。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["序列处理", "格式转换", "自动化"], "level": "进阶"}, {"id": "biopython-sequence-analysis", "title_zh": "序列分析与系统发育", "summary_zh": "解析序列文件、查询 NCBI、进行比对和构建系统发育树，用于基因家族和进化研究。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["序列比对", "系统发育", "NCBI"], "level": "进阶"}, {"id": "archs4-database", "title_zh": "ARCHS4 表达数据库查询", "summary_zh": "查询 ARCHS4 数据库，获取大量 RNA-seq 样本的基因表达和共表达信息，用于表达模式分析。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["表达数据库", "共表达", "RNA-seq"], "level": "入门"}, {"id": "bioservices-multi-database", "title_zh": "多数据库统一访问", "summary_zh": "通过 BioServices 库统一访问多个生物数据库，简化数据获取流程，适合需要跨库查询的场景。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["数据库", "API", "集成"], "level": "进阶"}, {"id": "cbioportal-database", "title_zh": "癌症基因组数据查询", "summary_zh": "查询 cBioPortal 中的癌症基因组数据，包括突变、拷贝数、表达和临床信息，用于肿瘤研究。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["癌症", "基因组", "临床数据"], "level": "入门"}, {"id": "clinpgx-database", "title_zh": "药物基因组学数据库查询", "summary_zh": "查询药物基因组学注释和用药指南，获取基因-药物关联和剂量建议，用于个体化用药研究。", "domain": "药物与化学", "subcategory": "药物基因组与药效", "tags_zh": ["药物基因组", "用药指南", "基因-药物"], "level": "入门"}]