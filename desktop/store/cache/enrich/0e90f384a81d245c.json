itizer", "title_zh": "临床变异优先级筛选", "summary_zh": "根据基因型数据，对照OMIM、ACMG-SF和遗传性癌症基因面板，结合ClinVar、gnomAD等数据库，筛选出具有临床意义的变异。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["变异筛选", "临床意义", "基因面板"], "level": "专家"}, {"id": "clinical-variant-reporter", "title_zh": "ACMG变异分类报告", "summary_zh": "根据ACMG/AMP 2015指南，对VCF/BCF文件中的胚系变异进行分类，并生成报告。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["ACMG", "变异分类", "胚系变异"], "level": "专家"}, {"id": "clinpgx", "title_zh": "药物基因组学数据查询", "summary_zh": "查询ClinPGx API，获取基因-药物关系、临床注释、CPIC指南和FDA药物标签等信息。", "domain": "药物与化学", "subcategory": "药物基因组与药效", "tags_zh": ["药物基因组", "基因-药物", "CPIC"], "level": "入门"}]