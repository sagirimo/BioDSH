[{"id": "tooluniverse-multi-omics-integration", "title_zh": "多组学数据整合分析", "summary_zh": "当你有多种组学数据（如基因表达、蛋白质、甲基化等）时，帮你整合分析，找出跨组学的关联和关键通路，用于系统生物学和精准医学研究。", "domain": "代谢与其他组学", "subcategory": "多组学整合", "tags_zh": ["多组学", "整合", "关联分析"], "level": "专家"}, {"id": "tooluniverse-multiomic-disease-characterization", "title_zh": "多组学疾病特征描绘", "summary_zh": "综合基因组、转录组、蛋白质组等多层数据，全面刻画疾病特征，给出定量评分、生物标志物候选和治疗机会，帮助理解疾病机制。", "domain": "代谢与其他组学", "subcategory": "多组学整合", "tags_zh": ["疾病", "多组学", "生物标志物"], "level": "专家"}, {"id": "tooluniverse-network-pharmacology", "title_zh": "网络药理学分析", "summary_zh": "构建药物-靶点-疾病网络，用于药物重定位和多靶点药理研究，计算网络药理学评分，预测药物作用机制和潜在适应症。", "domain": "药物与化学", "subcategory": "药物发现与筛选", "tags_zh": ["网络药理学", "药物重定位", "靶点"], "level": "专家"}, {"id": "tooluniverse-pharmacovigilance", "title_zh": "药物安全性监测分析", "summary_zh": "分析FDA不良事件报告和药物标签警告，计算信号强度指标，识别严重不良反应，评估药物基因组学风险，用于药物警戒和风险评估。", "domain": "药物与化学", "subcategory": "药物基因组与药效", "tags_zh": ["药物安全", "不良反应", "警戒"], "level": "进阶"}, {"id": "tooluniverse-phylogenetics", "title_zh": "系统发育与进化分析", "summary_zh": "处理序列比对，构建进化树，计算进化速率、树长等指标，用于研究物种或基因的进化关系，适合比较基因组和进化生物学研究。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["进化树", "系统发育", "序列分析"], "level": "进阶"}, {"id": "tooluniverse-polygenic-risk-score", "title_zh": "多基因风险评分计算", "summary_zh": "利用GWAS数据计算多基因风险评分，评估个体对复杂疾病（如糖尿病、冠心病）的遗传易感性，并解释风险百分位。", "domain": "基因组与变异", "subcategory": "GWAS 与群体遗传", "tags_zh": ["多基因风险", "遗传风险", "GWAS"], "level": "进阶"}, {"id": "tooluniverse-precision-medicine-stratification", "title_zh": "精准医学患者分层", "summary_zh": "整合基因组、临床和治疗数据，对患者进行多阶段分层，包括疾病鉴别、遗传风险评估、分子分型和药物基因组学，辅助个性化治疗决策。", "domain": "临床与医学", "subcategory": "临床数据与电子病历", "tags_zh": ["精准医学", "患者分层", "个性化治疗"], "level": "专家"}, {"id": "tooluniverse-precision-oncology", "title_zh": "精准肿瘤治疗推荐", "summary_zh": "根据肿瘤基因突变，推荐FDA批准的靶向药物，识别耐药机制，匹配临床试验，帮助医生为癌症患者制定个体化治疗方案。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["肿瘤", "靶向治疗", "临床试验"], "level": "专家"}, {"id": "protein-interaction-network-analysis", "title_zh": "蛋白质互作网络分析", "summary_zh": "利用STRING等数据库分析蛋白质相互作用网络，进行功能富集分析，发现互作伙伴和关键通路，无需API密钥即可使用核心功能。", "domain": "蛋白与结构", "subcategory": "蛋白互作", "tags_zh": ["蛋白质互作", "网络", "富集分析"], "level": "进阶"}, {"id": "tooluniverse-protein-structure-retrieval", "title_zh": "蛋白质结构检索与报告", "summary_zh": "从PDB、AlphaFold等数据库获取蛋白质三维结构，提供质量评估、配体信息和下载链接，生成详细的结构报告，适合结构生物学研究。", "domain": "蛋白与结构", "subcategory": "结构预测与建模", "tags_zh": ["蛋白质结构", "PDB", "AlphaFold"], "level": "入门"}, {"id": "tooluniverse-protein-therapeutic-design", "title_zh": "AI辅助蛋白治疗设计", "summary_zh": "使用AI工具（如RFdiffusion、ProteinMPNN）从头设计新型治疗性蛋白，包括结合蛋白、酶等，并验证结构，用于蛋白工程和药物开发。", "domain": "蛋白与结构", "subcategory": "蛋白设计", "tags_zh": ["蛋白设计", "AI", "治疗性蛋白"], "level": "专家"}, {"id": "tooluniverse-proteomics-analysis", "title_zh": "蛋白质组学数据分析", "summary_zh": "分析质谱蛋白质组数据，包括蛋白定量、差异表达、翻译后修饰和互作，进行归一化、统计分析和通路富集，并可与转录组整合。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["蛋白质组", "质谱", "差异表达"], "level": "进阶"}]