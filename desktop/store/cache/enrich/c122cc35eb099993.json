[{"id": "bio-proteomics-data-import", "title_zh": "蛋白质组数据导入与清洗", "summary_zh": "将质谱原始数据导入分析软件，去除反向序列、污染蛋白等干扰项，并区分不同定量类型，确保后续分析基于可靠数据。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["数据清洗", "质谱数据", "MaxQuant"], "level": "入门"}, {"id": "bio-proteomics-dia-analysis", "title_zh": "DIA蛋白质组数据分析", "summary_zh": "处理数据非依赖采集的蛋白质组数据，通过专业软件进行肽段鉴定和定量，并控制错误发现率，适用于大规模蛋白质组定量研究。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["DIA", "蛋白质组", "定量分析"], "level": "进阶"}, {"id": "bio-proteomics-differential-abundance", "title_zh": "蛋白质差异丰度分析", "summary_zh": "比较不同条件下蛋白质表达量的差异，使用统计模型处理缺失值，找出显著变化的蛋白质，常用于生物标志物发现。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["差异分析", "统计检验", "蛋白质组"], "level": "进阶"}, {"id": "bio-proteomics-peptide-identification", "title_zh": "肽段谱图匹配鉴定", "summary_zh": "将质谱碎片谱图与数据库比对，通过目标-诱饵库控制假阳性率，确定肽段序列，是蛋白质组鉴定的核心步骤。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["肽段鉴定", "FDR控制", "质谱"], "level": "进阶"}, {"id": "bio-proteomics-protein-inference", "title_zh": "蛋白质推断与分组", "summary_zh": "根据鉴定到的肽段推断蛋白质，处理共享肽段问题，将无法区分的蛋白质归为一组，并控制蛋白质水平的假阳性率。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["蛋白质推断", "蛋白分组", "FDR"], "level": "进阶"}, {"id": "bio-proteomics-proteomics-qc", "title_zh": "蛋白质组学质量控制", "summary_zh": "从仪器信号、鉴定结果和定量数据三个层面检查数据质量，识别异常样本和批次效应，确保后续分析可靠。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["质量控制", "数据检查", "蛋白质组"], "level": "入门"}, {"id": "bio-proteomics-ptm-analysis", "title_zh": "翻译后修饰位点分析", "summary_zh": "分析蛋白质磷酸化等修饰，包括修饰位点定位、定量和激酶活性推断，帮助理解细胞信号调控机制。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["翻译后修饰", "磷酸化", "位点定位"], "level": "专家"}, {"id": "bio-proteomics-quantification", "title_zh": "蛋白质定量分析", "summary_zh": "将质谱信号转化为蛋白质丰度，支持无标记、同位素标记等多种定量方法，并进行归一化处理，实现蛋白质组定量比较。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["蛋白质定量", "LFQ", "TMT"], "level": "进阶"}, {"id": "bio-proteomics-spectral-libraries", "title_zh": "谱图库构建与管理", "summary_zh": "构建用于DIA数据分析的谱图库，包括实验构建和计算机预测，并校准保留时间，提高肽段鉴定的准确性和灵敏度。", "domain": "蛋白与结构", "subcategory": "蛋白质组与质谱", "tags_zh": ["谱图库", "DIA", "保留时间校准"], "level": "进阶"}, {"id": "bio-read-alignment-bwa-alignment", "title_zh": "DNA序列比对到参考基因组", "summary_zh": "将DNA测序读段比对到参考基因组，使用BWA-MEM2等工具，为后续变异检测等分析做准备，适用于全基因组和外显子组测序。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["序列比对", "BWA", "基因组"], "level": "入门"}, {"id": "bio-read-alignment-hisat2-alignment", "title_zh": "RNA序列比对到基因组", "summary_zh": "将RNA测序读段比对到基因组，使用HISAT2等剪接感知比对器，适用于转录本定量和可变剪接分析，内存占用较低。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["RNA-seq", "比对", "HISAT2"], "level": "入门"}, {"id": "bio-read-alignment-star-alignment", "title_zh": "RNA序列快速比对到基因组", "summary_zh": "使用STAR等快速剪接感知比对器将RNA测序读段比对到基因组，适用于新转录本发现和融合基因检测，速度极快。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["RNA-seq", "比对", "STAR"], "level": "入门"}]