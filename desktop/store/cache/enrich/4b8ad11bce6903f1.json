[{"id": "bio-comparative-genomics-gene-tree-species-tree", "title_zh": "基因树与物种树协调分析", "summary_zh": "当你想知道基因家族的演化历史（如复制、转移、丢失）时，用此方法将基因树与物种树比对，推断祖先基因含量和演化事件。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["基因树", "物种树", "演化重建"], "level": "专家"}, {"id": "bio-comparative-genomics-genome-distance-and-spe", "title_zh": "基因组距离计算与物种分类", "summary_zh": "当你想确定两个微生物是否属于同一物种时，计算基因组间的相似度（如ANI），并参考标准阈值（如95%）进行物种界定。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["物种界定", "基因组相似度", "微生物分类"], "level": "进阶"}, {"id": "bio-comparative-genomics-hgt-detection", "title_zh": "水平基因转移检测", "summary_zh": "当你想知道细菌是否从其他物种获取了基因时，通过分析序列组成或系统发育不一致性来识别潜在的基因转移事件。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["基因转移", "细菌基因组", "系统发育"], "level": "进阶"}, {"id": "bio-comparative-genomics-introgression-detection", "title_zh": "种间基因渐渗检测", "summary_zh": "当你想知道两个物种之间是否发生过杂交或基因交流时，使用统计方法（如D统计量）检测基因组中的渐渗信号。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["基因渐渗", "杂交", "群体遗传"], "level": "进阶"}, {"id": "bio-comparative-genomics-ortholog-inference", "title_zh": "直系同源基因推断", "summary_zh": "当你想比较不同物种中的同源基因时，此方法可找出直系同源组，用于构建系统发育树或研究基因功能演化。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["直系同源", "基因家族", "系统发育"], "level": "进阶"}, {"id": "bio-comparative-genomics-pangenome-analysis", "title_zh": "泛基因组构建与分析", "summary_zh": "当你想了解一个物种的全部基因组成（核心基因和可变基因）时，构建泛基因组并分析其开放或闭合特性。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["泛基因组", "核心基因", "微生物"], "level": "进阶"}, {"id": "bio-comparative-genomics-positive-selection", "title_zh": "正选择压力检测", "summary_zh": "当你想知道某个基因是否在演化中受到适应性选择时，通过比较非同义和同义替换率（dN/dS）来检测正选择位点。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["正选择", "dN/dS", "适应性演化"], "level": "专家"}, {"id": "bio-comparative-genomics-synteny-analysis", "title_zh": "共线性区块分析", "summary_zh": "当你想比较不同基因组间的基因排列顺序时，此方法可找出共线性区块，揭示染色体结构重排和进化关系。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["共线性", "染色体结构", "基因组比较"], "level": "进阶"}, {"id": "bio-comparative-genomics-whole-genome-alignment", "title_zh": "全基因组比对", "summary_zh": "当你想比较两个或多个完整基因组序列时，此方法可生成全基因组比对，用于发现保守区域和结构变异。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["全基因组比对", "序列比对", "结构变异"], "level": "专家"}, {"id": "bio-comparative-genomics-whole-genome-duplicatio", "title_zh": "全基因组复制事件检测", "summary_zh": "当你想知道某个物种是否经历过全基因组复制（如多倍化）时，通过分析旁系同源基因和Ks分布来检测并估计事件时间。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["全基因组复制", "多倍化", "Ks分布"], "level": "专家"}, {"id": "bio-copy-number-allele-specific-copy-number", "title_zh": "等位基因特异性拷贝数分析", "summary_zh": "当你想从肿瘤测序数据中推断每个等位基因的拷贝数、肿瘤纯度和倍性时，此方法可区分杂合性缺失和拷贝数变化。", "domain": "基因组与变异", "subcategory": "结构变异与拷贝数", "tags_zh": ["拷贝数", "肿瘤纯度", "杂合性缺失"], "level": "专家"}, {"id": "bio-copy-number-cnv-annotation", "title_zh": "拷贝数变异注释", "summary_zh": "当你想知道拷贝数变异是否影响重要基因或与疾病相关时，此方法可注释变异涉及的基因、频率和临床意义。", "domain": "基因组与变异", "subcategory": "结构变异与拷贝数", "tags_zh": ["拷贝数变异", "注释", "临床意义"], "level": "进阶"}]