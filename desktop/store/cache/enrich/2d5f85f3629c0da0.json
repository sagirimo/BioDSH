zh": "药物基因组学报告", "summary_zh": "基于你的基因数据，分析药物代谢相关基因变异，提供用药风险提示和剂量建议。", "domain": "药物与化学", "subcategory": "药物基因组与药效", "tags_zh": ["药物基因组", "用药", "基因检测"], "level": "入门"}, {"id": "phylogenetics-builder", "title_zh": "系统发育树构建", "summary_zh": "从序列比对到构建进化树，自动选择最佳模型，输出可视化树文件，用于研究物种或基因的进化关系。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["进化树", "系统发育", "序列分析"], "level": "进阶"}, {"id": "polars-bio", "title_zh": "Polars 基因组区间运算", "summary_zh": "当需要处理 BED、VCF 等基因组文件时，用这个工具可以快速进行区间交集、合并等操作，速度很快。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["基因组", "区间", "高性能"], "level": "进阶"}]