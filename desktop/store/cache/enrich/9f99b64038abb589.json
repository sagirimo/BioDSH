spr-screens-mageck-analysis", "title_zh": "MAGeCK筛选数据分析", "summary_zh": "用于分析CRISPR筛选数据，识别在筛选条件下显著富集或耗竭的基因，是常用的标准分析工具。", "domain": "基因组与变异", "subcategory": "基因编辑与 CRISPR", "tags_zh": ["MAGeCK", "差异分析", "筛选数据"], "level": "入门"}, {"id": "bio-crispr-screens-perturb-seq-analysis", "title_zh": "单细胞CRISPR筛选分析", "summary_zh": "用于分析结合单细胞测序的CRISPR筛选，在单个细胞水平上研究基因敲除对转录组的影响，揭示基因功能。", "domain": "单细胞与空间", "subcategory": "单细胞多组学", "tags_zh": ["单细胞", "CRISPR", "转录组"], "level": "专家"}, {"id": "bio-crispr-screens-prime-editing-screens", "title_zh": "引导编辑筛选设计分析", "summary_zh": "用于设计并分析引导编辑筛选，精确引入特定基因突变，研究突变对细胞功能的影响，避免随机编辑。", "domain": "基因组与变异", "subcategory": "基因编辑与 CRISPR", "tags_zh": ["引导编辑", "精确突变", "筛选"], "level": "专家"}, {"id": "bio-crispr-screens-screen-qc", "title_zh": "CRISPR筛选质量控制", "summary_zh": "用于评估CRISPR筛选实验的质量，检查文库覆盖度、重复性等指标，确保数据可靠，避免后续分析偏差。", "domain": "基因组与变异", "subcategory": "基因编辑与 CRISPR", "tags_zh": ["质量控制", "重复性", "文库覆盖"], "level": "入门"}]