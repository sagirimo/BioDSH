[{"id": "workflow-management", "title_zh": "工作流管理", "summary_zh": "用于编排可重复的组学分析流程，确保每一步都有记录，方便复现和追踪。适合需要标准化流程的复杂分析。", "domain": "数据与工具", "subcategory": "流程与环境", "tags_zh": ["流程编排", "可重复性", "标准化"], "level": "进阶"}, {"id": "bio-basecalling", "title_zh": "Nanopore 碱基识别", "summary_zh": "将 Nanopore 测序的原始信号转换为 DNA 序列，支持模型选择、GPU 加速和修饰碱基检测。适用于处理原始测序数据。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["Nanopore", "信号转序列", "修饰碱基"], "level": "进阶"}, {"id": "bio-bedgraph-handling", "title_zh": "bedGraph 文件处理", "summary_zh": "创建、转换和操作 bedGraph 格式的覆盖度数据，用于基因组浏览器可视化。适合处理 ChIP-seq、ATAC-seq 等信号数据。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["bedGraph", "覆盖度", "可视化"], "level": "入门"}, {"id": "bio-genome-intervals-bigwig-tracks", "title_zh": "bigWig 轨道生成与读取", "summary_zh": "将 bedGraph 转换为 bigWig 格式，用于基因组浏览器显示连续信号，并可提取特定区域的信号值。适合准备覆盖度轨道。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["bigWig", "基因组浏览器", "信号提取"], "level": "入门"}, {"id": "bio-read-alignment-bowtie2-alignment", "title_zh": "Bowtie2 短读段比对", "summary_zh": "使用 Bowtie2 将短读段比对到参考基因组，支持局部和端到端模式，适合 ChIP-seq、ATAC-seq 等数据比对。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["比对", "短读段", "Bowtie2"], "level": "入门"}, {"id": "bio-de-results", "title_zh": "差异表达结果提取与注释", "summary_zh": "从 DESeq2 或 edgeR 结果中提取、过滤、注释和导出差异表达基因，用于后续分析。适合筛选显著基因并添加注释。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["差异表达", "基因注释", "结果筛选"], "level": "进阶"}, {"id": "bio-de-visualization", "title_zh": "差异表达结果可视化", "summary_zh": "使用 DESeq2/edgeR 内置函数绘制 MA 图、离散度图、样本距离热图等，直观展示差异表达分析结果。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["可视化", "MA图", "热图"], "level": "入门"}, {"id": "bio-de-deseq2-basics", "title_zh": "DESeq2 差异表达分析", "summary_zh": "使用 R 包 DESeq2 对 RNA-seq 计数数据进行差异表达分析，包括构建对象、运行流程和提取结果。适合标准差异表达分析。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["DESeq2", "RNA-seq", "差异表达"], "level": "进阶"}, {"id": "bio-de-edger-basics", "title_zh": "edgeR 差异表达分析", "summary_zh": "使用 R 包 edgeR 对 RNA-seq 计数数据进行差异表达分析，采用准似然 F 检验，包括归一化、离散度估计和统计检验。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["edgeR", "RNA-seq", "差异表达"], "level": "进阶"}, {"id": "bio-pdb-geometric-analysis", "title_zh": "蛋白质结构几何分析", "summary_zh": "使用 Biopython 计算蛋白质结构中的距离、角度、二面角，进行结构叠加和 RMSD 计算，以及溶剂可及表面积。", "domain": "蛋白与结构", "subcategory": "结构预测与建模", "tags_zh": ["蛋白质结构", "几何计算", "RMSD"], "level": "进阶"}, {"id": "bio-hi-c-analysis-hic-data-io", "title_zh": "Hi-C 接触矩阵读写转换", "summary_zh": "加载、转换和操作 Hi-C 接触矩阵，支持 cooler 格式，可读取 .cool/.mcool 文件，从 .hic 转换，并导出不同格式。", "domain": "表观与调控", "subcategory": "三维基因组", "tags_zh": ["Hi-C", "接触矩阵", "cooler"], "level": "进阶"}, {"id": "bio-liquid-biopsy-pipeline", "title_zh": "液体活检分析流程", "summary_zh": "从血浆测序数据中分析游离 DNA，包括片段模式、肿瘤分数估计和突变检测，用于癌症检测和监测。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["液体活检", "cfDNA", "肿瘤监测"], "level": "专家"}]