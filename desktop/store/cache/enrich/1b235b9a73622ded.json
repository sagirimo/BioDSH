[{"id": "bio-flow-cytometry-gating-analysis", "title_zh": "流式细胞术设门分析", "summary_zh": "通过手动或自动设门，从流式数据中划分细胞群体，得到各群体的比例和数量，用于免疫分型等研究。", "domain": "代谢与其他组学", "subcategory": "流式细胞", "tags_zh": ["细胞分群", "设门", "免疫分型"], "level": "进阶"}, {"id": "bio-gene-regulatory-networks-coexpression-networ", "title_zh": "加权基因共表达网络分析", "summary_zh": "构建基因共表达网络，找出协同变化的基因模块和关键基因，并关联表型，用于发现生物标志物或调控核心。", "domain": "转录组与表达", "subcategory": "共表达与网络", "tags_zh": ["共表达", "模块", "枢纽基因"], "level": "进阶"}, {"id": "bio-gene-regulatory-networks-differential-networ", "title_zh": "差异共表达网络分析", "summary_zh": "比较不同条件下基因网络的变化，找出被重连的基因关系，揭示疾病或处理引起的调控改变。", "domain": "转录组与表达", "subcategory": "共表达与网络", "tags_zh": ["差异网络", "重连", "条件比较"], "level": "专家"}, {"id": "bio-gene-regulatory-networks-grn-inference", "title_zh": "基因调控网络推断", "summary_zh": "从表达数据推断基因间的调控关系，识别关键转录因子及其靶基因，用于理解调控机制。", "domain": "表观与调控", "subcategory": "基因调控网络与转录因子", "tags_zh": ["调控网络", "转录因子", "推断"], "level": "进阶"}, {"id": "bio-gene-regulatory-networks-multiomics-grn", "title_zh": "多组学增强子调控网络构建", "summary_zh": "整合单细胞转录组和染色质可及性数据，构建增强子驱动的调控网络，揭示细胞身份决定机制。", "domain": "单细胞与空间", "subcategory": "单细胞多组学", "tags_zh": ["多组学", "增强子", "调控网络"], "level": "专家"}, {"id": "bio-gene-regulatory-networks-perturbation-simula", "title_zh": "转录因子扰动模拟", "summary_zh": "通过计算机模拟敲除或过表达转录因子，预测细胞状态的变化，用于设计实验和验证调控假设。", "domain": "转录组与表达", "subcategory": "共表达与网络", "tags_zh": ["扰动", "模拟", "预测"], "level": "专家"}, {"id": "bio-gene-regulatory-networks-scenic-regulons", "title_zh": "单细胞转录因子调控子分析", "summary_zh": "从单细胞数据推断转录因子调控子，并给每个细胞打分，用于识别细胞类型和关键调控因子。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "tags_zh": ["转录因子", "调控子", "单细胞"], "level": "进阶"}, {"id": "bio-genome-annotation-annotation-qc", "title_zh": "基因组注释质量评估", "summary_zh": "用BUSCO等工具检查基因注释的完整性和准确性，确保后续分析可靠，常用于新基因组项目。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["质量评估", "完整性", "BUSCO"], "level": "进阶"}, {"id": "bio-genome-annotation-annotation-transfer", "title_zh": "基因注释跨基因组转移", "summary_zh": "将已知物种的基因注释映射