[{"id": "bio-single-cell-batch-integration", "title_zh": "多批次单细胞数据整合", "summary_zh": "当你有多个样本或批次的单细胞数据时，用此方法消除技术差异，合并分析，同时保留真实的生物学差异。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "tags_zh": ["批次校正", "数据整合", "单细胞"], "level": "进阶"}, {"id": "bio-single-cell-cell-annotation", "title_zh": "自动注释细胞类型", "summary_zh": "利用已有参考数据，自动给新样本的每个细胞打上细胞类型标签，省去手动注释的麻烦。", "domain": "单细胞与空间", "subcategory": "细胞类型注释", "tags_zh": ["细胞注释", "参考图谱", "自动化"], "level": "入门"}, {"id": "bio-single-cell-cell-communication", "title_zh": "推断细胞间通讯", "summary_zh": "通过分析配体-受体对，预测细胞之间的交流信号，帮助理解细胞如何协同工作。", "domain": "单细胞与空间", "subcategory": "细胞通讯", "tags_zh": ["配体受体", "细胞通讯", "信号"], "level": "进阶"}, {"id": "bio-single-cell-clustering", "title_zh": "单细胞聚类分析", "summary_zh": "将相似的细胞自动分组，发现不同的细胞类型或状态，是单细胞数据分析的基础步骤。", "domain": "单细胞与空间", "subcategory": "聚类与降维", "tags_zh": ["聚类", "降维", "细胞分群"], "level": "入门"}, {"id": "bio-single-cell-cnv-inference", "title_zh": "推断拷贝数变异", "summary_zh": "从肿瘤单细胞数据中推断染色体拷贝数变化，帮助区分癌细胞和正常细胞，并发现亚克隆。", "domain": "单细胞与空间", "subcategory": "单细胞多组学", "tags_zh": ["拷贝数", "肿瘤", "亚克隆"], "level": "进阶"}, {"id": "bio-single-cell-data-io", "title_zh": "单细胞数据读写转换", "summary_zh": "在不同格式（如AnnData、Seurat）之间转换单细胞数据，确保数据正确加载和保存。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["数据格式", "转换", "单细胞"], "level": "入门"}, {"id": "bio-single-cell-differential-abundance", "title_zh": "细胞比例差异分析", "summary_zh": "比较不同条件下细胞类型比例的变化，找出哪些细胞群在疾病或治疗中增多或减少。", "domain": "单细胞与空间", "subcategory": "聚类与降维", "tags_zh": ["细胞比例", "差异分析", "组成"], "level": "进阶"}, {"id": "bio-single-cell-doublet-detection", "title_zh": "检测并去除双细胞", "summary_zh": "识别并移除实验中意外合并的两个细胞，避免它们干扰后续分析。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "tags_zh": ["双细胞", "质控", "去除"], "level": "入门"}, {"id": "bio-single-cell-hashing-demultiplexing", "title_zh": "样本标签拆分", "summary_zh": "将混合测序的多个样本根据标签（如HTO）区分开来，并识别跨样本的双细胞。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "tags_zh": ["样本拆分", "标签", "多重测序"], "level": "进阶"}, {"id": "bio-single-cell-lineage-tracing", "title_zh": "谱系追踪分析", "summary_zh": "利用基因编辑留下的标记，重建细胞的分化历史和亲缘关系。", "domain": "单细胞与空间", "subcategory": "轨迹与动态", "tags_zh": ["谱系", "克隆", "发育"], "level": "专家"}, {"id": "bio-single-cell-markers-annotation", "title_zh": "标记基因与手动注释", "summary_zh": "找出每个细胞群的标志性基因，并手动赋予细胞类型名称，是注释细胞类型的常用方法。", "domain": "单细胞与空间", "subcategory": "细胞类型注释", "tags_zh": ["标记基因", "手动注释", "细胞类型"], "level": "入门"}, {"id": "bio-single-cell-metabolite-communication", "title_zh": "代谢物介导的细胞通讯", "summary_zh": "预测细胞通过代谢物（如神经递质）进行交流，研究代谢层面的细胞间相互作用。", "domain": "单细胞与空间", "subcategory": "细胞通讯", "tags_zh": ["代谢物", "细胞通讯", "神经递质"], "level": "专家"}]