[{"id": "bio-genome-annotation-prokaryotic-annotation", "title_zh": "细菌基因组功能注释", "summary_zh": "给细菌或古菌的基因组序列标注基因功能，输出标准格式文件，方便后续研究和提交数据库。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["细菌", "基因预测", "功能注释"], "level": "入门"}, {"id": "bio-genome-annotation-repeat-annotation", "title_zh": "重复序列注释与屏蔽", "summary_zh": "找出基因组中的重复序列和转座子，进行分类和屏蔽，避免它们干扰基因分析，还能研究其表达。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["重复序列", "转座子", "屏蔽"], "level": "进阶"}, {"id": "bio-genome-assembly-assembly-polishing", "title_zh": "基因组组装结果纠错", "summary_zh": "对初步拼好的基因组序列进行修正，提高准确性，根据测序数据类型选择合适的纠错工具。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["纠错", "组装优化", "准确性"], "level": "进阶"}, {"id": "bio-genome-assembly-assembly-qc", "title_zh": "基因组组装质量评估", "summary_zh": "从连续性、完整性和正确性三个方面评估基因组组装的好坏，避免被单一的N50指标误导。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["质量评估", "连续性", "完整性"], "level": "进阶"}, {"id": "bio-genome-assembly-contamination-detection", "title_zh": "基因组组装污染检测", "summary_zh": "检查基因组组装中是否混入了其他物种的DNA，并去除污染，确保后续分析结果的纯净可靠。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["污染检测", "去污染", "质量控制"], "level": "进阶"}, {"id": "bio-genome-assembly-genome-profiling", "title_zh": "基因组特征预估", "summary_zh": "在组装前，利用测序数据预估基因组的大小、杂合度、重复序列含量和倍性，为组装策略提供参考。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["基因组大小", "杂合度", "倍性"], "level": "进阶"}, {"id": "bio-genome-assembly-hifi-assembly", "title_zh": "高精度长读长基因组组装", "summary_zh": "利用PacBio HiFi等高质量长读长数据，组装出单倍型分辨甚至端粒到端粒的完整基因组。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["HiFi", "单倍型", "T2T"], "level": "专家"}, {"id": "bio-genome-assembly-long-read-assembly", "title_zh": "长读长基因组组装", "summary_zh": "利用纳米孔等长读长测序数据从头组装基因组，获得更连续、更完整的序列，尤其适合复杂基因组。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["长读长", "纳米孔", "从头组装"], "level": "进阶"}, {"id": "bio-genome-assembly-metagenome-assembly", "title_zh": "宏基因组组装与基因组恢复", "summary_zh": "从混合微生物群落的测序数据中组装出单个微生物的基因组（MAGs），并评估其质量。", "domain": "微生物与免疫", "subcategory": "宏基因组与微生物组", "tags_zh": ["宏基因组", "MAG", "微生物群落"], "level": "专家"}, {"id": "bio-genome-assembly-scaffolding", "title_zh": "基因组支架搭建", "summary_zh": "利用Hi-C等长距离信息，将组装好的片段排序和定向，拼成染色体级别的支架结构。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["Hi-C", "染色体", "支架"], "level": "进阶"}, {"id": "bio-genome-assembly-short-read-assembly", "title_zh": "短读长基因组组装", "summary_zh": "利用Illumina等短读长测序数据从头组装基因组，适合细菌等较小基因组，成本较低。", "domain": "基因组与变异", "subcategory": "基因组组装与注释", "tags_zh": ["短读长", "Illumina", "从头组装"], "level": "进阶"}, {"id": "bio-genome-engineering-base-editing-design", "title_zh": "碱基编辑向导设计", "summary_zh": "设计碱基编辑器的向导RNA，实现精准的单个碱基替换，同时尽量减少脱靶编辑。", "domain": "基因组与变异", "subcategory": "基因编辑与 CRISPR", "tags_zh": ["碱基编辑", "向导RNA", "精准编辑"], "level": "专家"}]