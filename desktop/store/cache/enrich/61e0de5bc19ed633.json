[{"id": "bcftools-norm-run", "title_zh": "VCF 文件标准化处理", "summary_zh": "当你的 VCF 文件格式不统一时，用这个工具可以规范化变异记录，方便后续比较和分析。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["VCF", "标准化", "变异"], "level": "入门"}, {"id": "bedtools-coverage", "title_zh": "区间覆盖度统计", "summary_zh": "想知道测序数据在特定基因组区域（如基因）上的覆盖情况？这个工具能统计每个区间的覆盖度或重叠数。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["覆盖度", "区间", "bedtools"], "level": "入门"}, {"id": "bedtools-genomecov", "title_zh": "全基因组覆盖度分析", "summary_zh": "需要了解测序深度在全基因组上的分布？这个工具能从 BAM 文件生成覆盖度图谱，帮助评估测序质量。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["覆盖度", "基因组", "测序质量"], "level": "入门"}, {"id": "bedtools-intersect", "title_zh": "基因组区间交集分析", "summary_zh": "当你想知道两个基因组区间集合（如基因和变异位点）的重叠情况时，这个工具能找出所有重叠区域。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["区间", "交集", "bedtools"], "level": "入门"}, {"id": "blast-formatter-run", "title_zh": "BLAST 结果格式转换", "summary_zh": "如果你有 BLAST 的存档文件，想换成表格、XML 或 HTML 格式，这个工具可以帮你转换，方便查看或导入其他软件。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["BLAST", "格式转换"], "level": "入门"}, {"id": "blastdb-aliastool-run", "title_zh": "创建 BLAST 数据库别名", "summary_zh": "当你有多个 BLAST 数据库，想合并成一个虚拟数据库来搜索时，这个工具可以创建别名数据库，简化搜索流程。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["BLAST", "数据库", "别名"], "level": "进阶"}, {"id": "blastdbcheck-run", "title_zh": "BLAST 数据库完整性检查", "summary_zh": "担心 BLAST 数据库文件损坏或不完整？这个工具能检查数据库的完整性，确保搜索结果的可靠性。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["BLAST", "数据库", "完整性"], "level": "入门"}, {"id": "blastdbcmd-run", "title_zh": "BLAST 数据库序列提取", "summary_zh": "需要从 BLAST 数据库中提取特定序列或元数据？这个工具可以按 ID 或关键词检索并输出序列信息。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["BLAST", "数据库", "序列提取"], "level": "入门"}, {"id": "blastn-search", "title_zh": "核酸序列同源搜索", "summary_zh": "当你有一段 DNA 序列，想找相似序列时，用 BLASTN 搜索核酸数据库，结果以表格形式给出。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["BLAST", "同源搜索", "核酸"], "level": "入门"}, {"id": "blastp-search", "title_zh": "蛋白质序列同源搜索", "summary_zh": "当你有一段蛋白质序列，想找相似蛋白时，用 BLASTP 搜索蛋白数据库，结果以表格形式给出。", "domain": "蛋白与结构", "subcategory": "蛋白互作", "tags_zh": ["BLAST", "同源搜索", "蛋白质"], "level": "入门"}, {"id": "blastx-search", "title_zh": "翻译后蛋白同源搜索", "summary_zh": "当你有核酸序列但想找蛋白同源物时，BLASTX 会先翻译成蛋白再搜索，适合预测新基因的功能。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["BLAST", "同源搜索", "翻译"], "level": "入门"}, {"id": "bowtie2-align", "title_zh": "短读段比对到参考基因组", "summary_zh": "将二代测序的短读段比对到参考基因组上，生成索引文件，是很多下游分析（如变异检测）的第一步。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["比对", "短读段", "Bowtie2"], "level": "入门"}]