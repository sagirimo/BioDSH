": ["微生物组", "物种分类", "功能分析"], "level": "专家"}, {"id": "bio-workflows-methylation-pipeline", "title_zh": "DNA 甲基化分析流程", "summary_zh": "从测序数据到差异甲基化区域，分析亚硫酸盐测序数据，适用于研究表观遗传调控。", "domain": "表观与调控", "subcategory": "DNA 甲基化", "tags_zh": ["甲基化", "亚硫酸盐测序", "差异甲基化"], "level": "专家"}, {"id": "bio-workflows-microbiome-pipeline", "title_zh": "扩增子微生物组分析", "summary_zh": "从测序数据到物种组成和差异丰度，分析 16S/ITS 扩增子数据，适用于研究微生物群落。", "domain": "微生物与免疫", "subcategory": "宏基因组与微生物组", "tags_zh": ["16S", "微生物多样性", "扩增子"], "level": "专家"}, {"id": "bio-workflows-multi-omics-pipeline", "title_zh": "多组学整合分析", "summary_zh": "整合同一批样本的多种组学数据，如转录组、蛋白组和甲基化，适用于发现跨组学关联和分子亚型。", "domain": "代谢与其他组学", "subcategory": "多组学整合", "tags_zh": ["多组学", "数据整合", "分子分型"], "level": "专家"}]