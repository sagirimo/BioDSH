-graphql", "title_zh": "Open Targets GraphQL查询", "summary_zh": "使用GraphQL语言查询Open Targets数据库，获取靶点-疾病-药物关联信息，适合需要定制化查询的研究者。", "domain": "药物与化学", "subcategory": "药物基因组与药效", "tags_zh": ["GraphQL", "靶点", "药物"], "level": "进阶"}, {"id": "openfold3", "title_zh": "OpenFold3蛋白质结构预测", "summary_zh": "使用OpenFold3预测蛋白质与核酸、配体等复合物的三维结构，适合没有实验结构时进行结构建模。", "domain": "蛋白与结构", "subcategory": "结构预测与建模", "tags_zh": ["结构预测", "蛋白质复合物", "AlphaFold"], "level": "专家"}, {"id": "paper-download", "title_zh": "学术论文PDF下载", "summary_zh": "从arXiv、PubMed、bioRxiv等平台搜索并下载论文PDF，适合需要获取全文文献时使用。", "domain": "数据与工具", "subcategory": "文献检索与阅读", "tags_zh": ["论文下载", "PDF", "文献获取"], "level": "入门"}]