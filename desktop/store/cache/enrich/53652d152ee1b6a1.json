[{"id": "bio-data-visualization-circos-plots", "title_zh": "环形基因组图绘制", "summary_zh": "当需要展示染色体间相互作用或基因组特征分布时，用环形图直观呈现，比线性图更适合展示全局关系。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["环形图", "基因组", "可视化"], "level": "进阶"}, {"id": "bio-data-visualization-color-palettes", "title_zh": "科学配色方案选择", "summary_zh": "为热图、散点图等选择颜色时，使用色盲友好且感知均匀的调色板，避免彩虹色，确保数据准确传达。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["配色", "色盲友好", "科学绘图"], "level": "入门"}, {"id": "bio-data-visualization-dimensionality-reduction", "title_zh": "高维数据降维可视化", "summary_zh": "当数据维度太多难以直接观察时，用PCA、t-SNE、UMAP等方法降到二维，但需注意不同方法保留的信息不同。", "domain": "数据与工具", "subcategory": "统计与机器学习", "tags_zh": ["降维", "PCA", "UMAP"], "level": "进阶"}, {"id": "bio-data-visualization-distribution-plots", "title_zh": "数据分布图绘制", "summary_zh": "比较几组数据的分布时，用箱线图、小提琴图或雨云图，避免只用平均值柱状图，能更真实反映数据全貌。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["箱线图", "小提琴图", "分布"], "level": "入门"}, {"id": "bio-data-visualization-flow-and-transition-plots", "title_zh": "流动与转换图绘制", "summary_zh": "当需要展示样本或细胞在不同类别间的流动（如临床试验患者流程、细胞状态变化）时，用桑基图或冲积图。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["桑基图", "冲积图", "流程"], "level": "进阶"}, {"id": "bio-data-visualization-forest-funnel-plots", "title_zh": "森林图与漏斗图绘制", "summary_zh": "在荟萃分析或孟德尔随机化中，用森林图展示各研究的效应量及置信区间，用漏斗图检测发表偏倚。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["森林图", "漏斗图", "荟萃分析"], "level": "进阶"}, {"id": "bio-data-visualization-genome-tracks", "title_zh": "基因组浏览器轨道图绘制", "summary_zh": "当需要展示特定基因组区域的测序覆盖度、峰值或基因结构时，用基因组轨道图，可叠加多个数据层。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["基因组轨道", "覆盖度", "可视化"], "level": "进阶"}, {"id": "bio-data-visualization-ggplot2-fundamentals", "title_zh": "R语言ggplot2绘图基础", "summary_zh": "用R的ggplot2包制作出版级图表，通过图层语法灵活控制图形元素，适合论文和报告中的静态图。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["ggplot2", "R语言", "出版级"], "level": "入门"}, {"id": "bio-data-visualization-heatmaps-clustering", "title_zh": "聚类热图绘制", "summary_zh": "当需要展示基因表达矩阵等数据时，用聚类热图同时呈现数值和聚类模式，注意距离度量和颜色映射的选择。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["热图", "聚类", "表达矩阵"], "level": "进阶"}, {"id": "bio-data-visualization-lollipop-protein-maps", "title_zh": "蛋白质突变棒棒糖图绘制", "summary_zh": "当需要展示基因突变在蛋白质上的位置和频率时，用棒棒糖图，可标记结构域和突变类型。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["棒棒糖图", "突变", "蛋白质"], "level": "进阶"}, {"id": "bio-data-visualization-matplotlib-fundamentals", "title_zh": "Python matplotlib绘图基础", "summary_zh": "用Python的matplotlib库制作出版级图表，通过面向对象接口精细控制，适合论文和报告中的静态图。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["matplotlib", "Python", "出版级"], "level": "入门"}, {"id": "bio-data-visualization-multipanel-figures", "title_zh": "多面板组合图制作", "summary_zh": "当需要将多个子图组合成一张论文图时，用patchwork或GridSpec等工具，统一图例和标签，符合期刊要求。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["多面板", "组合图", "论文图"], "level": "进阶"}]