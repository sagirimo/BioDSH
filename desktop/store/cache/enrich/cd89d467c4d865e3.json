[{"id": "wes-clinical-report-es", "title_zh": "WES 临床报告生成（西班牙语）", "summary_zh": "从全外显子测序数据自动生成西班牙语的专业临床 PDF 报告，包含变异解读和临床建议，适合直接用于临床沟通。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["临床报告", "全外显子", "西班牙语"], "level": "专家"}, {"id": "wgs-prs", "title_zh": "全基因组到多基因风险评分流程", "summary_zh": "从测序原始数据或已有 VCF 文件出发，完成变异检测、质控和多基因风险评分计算，用于评估个体遗传风险。", "domain": "基因组与变异", "subcategory": "GWAS 与群体遗传", "tags_zh": ["全基因组", "风险评分", "变异检测"], "level": "专家"}, {"id": "xena-tcga-gene-query", "title_zh": "TCGA 肿瘤基因查询", "summary_zh": "查询 TCGA 肿瘤数据库，获取特定基因在不同癌症中的表达和临床关联数据，帮助回答基因与癌症关系的问题。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["TCGA", "肿瘤", "基因表达"], "level": "入门"}, {"id": "bio-alignment-amplicon-clipping", "title_zh": "扩增子引物序列修剪", "summary_zh": "从比对好的 BAM 文件中去除 PCR 引物序列，避免引物区域错误比对，适用于扩增子测序数据（如新冠、癌症 panel）。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["引物修剪", "扩增子", "BAM"], "level": "进阶"}, {"id": "bio-alignment-filtering", "title_zh": "比对文件过滤", "summary_zh": "根据比对质量、比对标志或区域筛选 BAM 文件中的 reads，用于提取特定 reads 或去除低质量比对。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["BAM", "过滤", "比对质量"], "level": "入门"}, {"id": "bio-alignment-indexing", "title_zh": "比对文件索引建立", "summary_zh": "为 BAM/CRAM 文件建立索引，以便快速访问特定基因组区域的数据，是后续分析的基础步骤。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["索引", "BAM", "快速访问"], "level": "入门"}, {"id": "bio-alignment-sorting", "title_zh": "比对文件排序", "summary_zh": "将 BAM 文件按坐标或 read 名称排序，为后续索引、变异检测和双端分析做准备。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["排序", "BAM", "预处理"], "level": "入门"}, {"id": "bio-alignment-validation", "title_zh": "比对质量验证", "summary_zh": "评估比对数据的质量，包括插入片段大小、配对率、GC 偏差等指标，确保数据可靠后再进行下游分析。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["质控", "比对", "质量评估"], "level": "进阶"}, {"id": "bio-bam-statistics", "title_zh": "BAM 文件统计与覆盖度计算", "summary_zh": "生成比对统计信息，如比对率、覆盖度、深度等，用于评估测序质量和生成 QC 报告。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["统计", "覆盖度", "QC"], "level": "入门"}, {"id": "bio-duplicate-handling", "title_zh": "PCR 重复序列标记与去除", "summary_zh": "标记并去除 PCR 或光学重复的 reads，避免它们影响变异检测的准确性，是变异分析前的必要步骤。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["重复序列", "PCR", "变异检测"], "level": "进阶"}, {"id": "bio-pileup-generation", "title_zh": "生成比对堆叠数据", "summary_zh": "生成每个位置的 reads 堆叠信息，用于变异检测、等位基因频率计算或查看特定位置的 reads 情况。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["pileup", "变异检测", "等位基因"], "level": "进阶"}, {"id": "bio-reference-operations", "title_zh": "参考序列管理与一致性序列生成", "summary_zh": "管理参考基因组文件，包括建立索引、生成一致性序列等，用于比对和变异分析的基础操作。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["参考基因组", "一致性序列", "索引"], "level": "入门"}]