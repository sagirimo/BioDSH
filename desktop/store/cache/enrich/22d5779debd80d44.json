[{"id": "bio-hi-c-analysis-contact-pairs", "title_zh": "Hi-C 数据生成接触对文件", "summary_zh": "将 Hi-C/Micro-C 测序数据比对并处理成去重、过滤后的接触对文件，同时判断实验是否成功。适合刚拿到测序数据、需要生成标准接触对文件的场景。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["Hi-C", "接触对", "比对", "质控"], "level": "进阶"}, {"id": "bio-hi-c-analysis-hic-differential", "title_zh": "Hi-C 差异分析比较不同条件", "summary_zh": "比较不同条件下染色质接触的差异，包括差异接触区域、区室、边界和环，并考虑距离和重复样本的影响。适合研究基因调控变化时使用。", "domain": "表观与调控", "subcategory": "三维基因组", "tags_zh": ["Hi-C", "差异分析", "三维基因组"], "level": "专家"}, {"id": "bio-hi-c-analysis-hic-visualization", "title_zh": "Hi-C 接触矩阵可视化", "summary_zh": "用多种工具绘制 Hi-C 接触矩阵图，并选择合适的归一化方法和颜色，以清晰展示染色质结构。适合展示三维基因组数据时使用。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["Hi-C", "可视化", "接触矩阵"], "level": "入门"}, {"id": "bio-hi-c-analysis-hichip-plac-loops", "title_zh": "HiChIP/PLAC-seq 环检测", "summary_zh": "从 HiChIP、PLAC-seq 等靶向 3C 数据中检测显著的染色质环，使用专门针对这些数据特点的工具。适合研究特定蛋白介导的染色质相互作用。", "domain": "表观与调控", "subcategory": "三维基因组", "tags_zh": ["HiChIP", "PLAC-seq", "染色质环"], "level": "专家"}, {"id": "bio-hi-c-analysis-loop-calling", "title_zh": "Hi-C 环检测与验证", "summary_zh": "从 Hi-C 数据中检测点状染色质环，并用聚合分析验证环的可靠性。适合寻找增强子-启动子等远程相互作用时使用。", "domain": "表观与调控", "subcategory": "三维基因组", "tags_zh": ["Hi-C", "染色质环", "检测"], "level": "进阶"}, {"id": "bio-hi-c-analysis-matrix-operations", "title_zh": "Hi-C 矩阵归一化与距离衰减", "summary_zh": "对 Hi-C 接触矩阵进行归一化，计算距离衰减曲线和观察/期望矩阵，以诊断染色质状态。适合在分析前处理 Hi-C 数据时使用。", "domain": "表观与调控", "subcategory": "三维基因组", "tags_zh": ["Hi-C", "归一化", "距离衰减"], "level": "进阶"}, {"id": "bio-hi-c-analysis-tad-detection", "title_zh": "TAD 边界检测", "summary_zh": "从 Hi-C 数据中识别拓扑关联结构域（TAD）的边界，并计算边界强度。适合研究基因调控区域划分时使用。", "domain": "表观与调控", "subcategory": "三维基因组", "tags_zh": ["TAD", "边界", "Hi-C"], "level": "进阶"}, {"id": "bio-imaging-mass-cytometry-cell-segmentation", "title_zh": "质谱成像细胞分割", "summary_zh": "从多重成像质谱数据中分割出单个细胞，使用深度学习或传统方法，并评估分割质量。适合分析组织切片中的细胞空间分布时使用。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["质谱成像", "细胞分割", "图像分析"], "level": "进阶"}, {"id": "bio-imaging-mass-cytometry-data-preprocessing", "title_zh": "质谱成像数据预处理", "summary_zh": "加载并预处理成像质谱数据，包括去除热点、补偿溢出和方差稳定化，为后续分析做准备。适合处理原始 MCD 文件时使用。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["质谱成像", "预处理", "补偿"], "level": "进阶"}, {"id": "bio-imaging-mass-cytometry-differential-analysis", "title_zh": "质谱成像差异分析", "summary_zh": "比较不同条件下细胞类型组成和空间特征的差异，以患者为实验单位，避免伪重复。适合研究疾病或处理对组织微环境的影响时使用。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["质谱成像", "差异分析", "空间统计"], "level": "专家"}, {"id": "bio-imaging-mass-cytometry-interactive-annotatio", "title_zh": "质谱成像交互式细胞标注", "summary_zh": "使用交互式工具手动标注细胞并检查图像质量，为机器学习提供训练数据。适合需要人工验证分割结果或生成标注数据时使用。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["质谱成像", "交互式标注", "图像质控"], "level": "入门"}, {"id": "bio-imaging-mass-cytometry-phenotyping", "title_zh": "质谱成像细胞分型", "summary_zh": "根据标记物表达将细胞分为不同类型，使用聚类或分类器，并考虑分割伪影。适合识别组织中的细胞类型时使用。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["质谱成像", "细胞分型", "聚类"], "level": "进阶"}]