[{"id": "bio-rna-quantification-alignment-free-quant", "title_zh": "无比对转录本定量", "summary_zh": "用 Salmon 或 kallisto 直接从测序数据计算基因表达量，无需比对到基因组。适合快速定量，需注意文库链特异性等参数设置。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["转录定量", "无比对", "Salmon"], "level": "进阶"}, {"id": "bio-rna-quantification-count-matrix-qc", "title_zh": "表达矩阵质控与探索", "summary_zh": "在差异表达分析前，检查表达矩阵的质量，包括文库大小、样本相关性、离群样本等，并选择合适的标准化方法。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["质控", "标准化", "PCA"], "level": "进阶"}, {"id": "bio-rna-quantification-featurecounts-counting", "title_zh": "基因计数矩阵生成", "summary_zh": "用 featureCounts 从比对好的 BAM 文件统计每个基因的读数，生成用于差异表达分析的计数矩阵。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["基因计数", "BAM", "featureCounts"], "level": "进阶"}, {"id": "bio-rna-quantification-tximport-workflow", "title_zh": "转录本定量导入分析", "summary_zh": "将 Salmon 等工具得到的转录本水平定量结果导入 R，汇总为基因水平，供 DESeq2 等差异表达分析使用。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["数据导入", "tximport", "DESeq2"], "level": "进阶"}, {"id": "bio-rna-structure-covariation-analysis", "title_zh": "RNA结构共变分析", "summary_zh": "用 R-scape 检验 RNA 二级结构是否得到进化共变支持，避免误信无证据的结构预测。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["RNA结构", "共变分析", "进化"], "level": "专家"}, {"id": "bio-rna-structure-ncrna-search", "title_zh": "非编码RNA同源搜索", "summary_zh": "用 Infernal 协方差模型搜索非编码 RNA 同源物，同时考虑序列和结构保守性，比单纯序列比对更准确。", "domain": "转录组与表达", "subcategory": "非编码 RNA", "tags_zh": ["非编码RNA", "协方差模型", "Rfam"], "level": "专家"}, {"id": "bio-rna-structure-secondary-structure-prediction", "title_zh": "RNA二级结构预测", "summary_zh": "用 ViennaRNA 预测 RNA 二级结构，考虑热力学集合，可进行一致性折叠、结合位点预测等。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["RNA结构", "ViennaRNA", "热力学"], "level": "进阶"}, {"id": "bio-rna-structure-structure-probing", "title_zh": "RNA结构探测数据处理", "summary_zh": "处理 SHAPE-MaP 等实验数据，得到每个核苷酸的反应性，并作为约束用于 RNA 结构预测。", "domain": "基因组与变异", "subcategory": "比较与进化基因组", "tags_zh": ["结构探测", "SHAPE", "反应性"], "level": "专家"}, {"id": "bio-batch-processing", "title_zh": "批量处理序列文件", "summary_zh": "用 Biopython 等工具批量处理大量序列文件，如计数、合并、拆分、转换，内存友好，适合自动化。", "domain": "数据与工具", "subcategory": "流程与环境", "tags_zh": ["批量处理", "Biopython", "自动化"], "level": "进阶"}, {"id": "bio-compressed-files", "title_zh": "压缩序列文件读写", "summary_zh": "处理 gzip、bzip2、BGZF 等压缩格式的序列文件，支持随机访问，注意 BGZF 与 gzip 的区别。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["压缩文件", "BGZF", "随机访问"], "level": "进阶"}, {"id": "bio-fastq-quality", "title_zh": "FASTQ质量值处理", "summary_zh": "用 Biopython 处理 FASTQ 质量值，包括过滤、修剪、质量编码转换等，确保正确解析。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["FASTQ", "质量值", "过滤"], "level": "入门"}, {"id": "bio-filter-sequences", "title_zh": "序列筛选与过滤", "summary_zh": "按长度、GC含量、序列模式等条件筛选 FASTA/FASTQ 序列，流式处理，不占内存。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["序列筛选", "FASTA", "过滤"], "level": "入门"}]