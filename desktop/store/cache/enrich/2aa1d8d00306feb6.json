 "summary_zh": "当你想从测序数据开始分析染色质开放性时，用这个工具可以完成从数据质控到差异分析的全流程，帮你找到开放区域和调控元件。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["染色质开放性", "全流程", "差异分析"], "level": "进阶"}, {"id": "bio-workflows-biomarker-pipeline", "title_zh": "生物标志物发现流程", "summary_zh": "当你想从组学数据中找出能诊断或预测疾病的标志物时，用这个工具可以筛选特征、验证模型，并解释哪些因素最重要。", "domain": "临床与医学", "subcategory": "疾病与表型", "tags_zh": ["生物标志物", "特征筛选", "模型验证"], "level": "专家"}, {"id": "bio-workflows-causal-genomics-pipeline", "title_zh": "因果基因推断流程", "summary_zh": "当你想从遗传关联数据中找出真正导致疾病的基因时，用这个工具可以整合多种分析方法，帮你理清因果关系。", "domain": "基因组与变异", "subcategory": "GWAS 与群体遗传", "tags_zh": ["因果推断", "遗传关联", "基因定位"], "level": "专家"}, {"id": "bio-workflows-chipseq-pipeline", "title_zh": "ChIP-seq 全流程分析", "summary_zh": "当你想研究蛋白质与 DNA 的结合位置时，用这个工具可以完成从测序数据到结合位点鉴定的全流程，帮你找到调控区域。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["蛋白结合", "全流程", "峰识别"], "level": "进阶"}]