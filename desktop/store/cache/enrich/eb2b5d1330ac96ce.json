[{"id": "bio-chipseq-qc", "title_zh": "ChIP-seq 质量评估", "summary_zh": "用于验证抗体特异性、检查片段化效果、评估富集度和重复一致性，并检测文库复杂度问题，帮助判断实验是否成功。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["质控", "抗体验证", "重复性", "文库复杂度"], "level": "进阶"}, {"id": "bio-chipseq-visualization", "title_zh": "ChIP-seq 数据可视化", "summary_zh": "使用多种工具绘制峰图、热图、剖面图等，直观展示染色质修饰或转录因子结合模式，便于比较不同样本或条件。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["可视化", "热图", "峰图", "bigWig"], "level": "进阶"}, {"id": "bio-chipseq-chromatin-state-segmentation", "title_zh": "染色质状态分割", "summary_zh": "根据组蛋白修饰和染色质因子的 ChIP-seq 数据，将基因组划分为不同的染色质状态（如启动子、增强子、异染色质），揭示调控元件。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["染色质状态", "ChromHMM", "组蛋白修饰", "基因组分割"], "level": "专家"}, {"id": "bio-chipseq-cut-and-run-tag", "title_zh": "CUT&RUN / CUT&Tag 数据分析", "summary_zh": "专门处理 CUT&RUN 和 CUT&Tag 这类低背景染色质分析数据，包括峰检测、归一化和质量控制，适合少量细胞或珍贵样本。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["CUT&RUN", "CUT&Tag", "低细胞量", "峰检测"], "level": "进阶"}, {"id": "bio-chipseq-differential-binding", "title_zh": "ChIP-seq 差异结合分析", "summary_zh": "比较不同条件下蛋白结合强度的差异，找出显著变化的区域，并处理多种归一化问题，适用于疾病与对照的比较。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["差异结合", "DiffBind", "归一化", "条件比较"], "level": "进阶"}, {"id": "bio-chipseq-motif-analysis", "title_zh": "转录因子结合基序分析", "summary_zh": "在 ChIP-seq 或 ATAC-seq 的峰区域中寻找已知或新的 DNA 序列模式（基序），帮助识别转录因子的结合位点。", "domain": "表观与调控", "subcategory": "基因调控网络与转录因子", "tags_zh": ["基序", "转录因子", "HOMER", "MEME"], "level": "进阶"}, {"id": "bio-chipseq-peak-annotation", "title_zh": "ChIP-seq 峰注释", "summary_zh": "将 ChIP-seq 峰定位到基因、调控元件等基因组特征上，并关联到可能受调控的基因，帮助理解峰的生物学意义。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["峰注释", "基因关联", "调控元件", "ChIPseeker"], "level": "入门"}, {"id": "bio-chipseq-peak-calling", "title_zh": "ChIP-seq 峰检测", "summary_zh": "从 ChIP-seq 数据中识别蛋白结合或组蛋白修饰的显著富集区域（峰），是 ChIP-seq 分析的核心步骤，支持窄峰和宽峰模式。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["峰检测", "MACS", "组蛋白修饰", "转录因子"], "level": "进阶"}, {"id": "bio-chipseq-spike-in-normalization", "title_zh": "ChIP-seq 外源归一化", "summary_zh": "利用加入的外源 DNA（如果蝇染色质）进行归一化，校正样本间技术差异，使不同条件下的结合强度可比，尤其适用于全局变化。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["归一化", "spike-in", "ChIP-Rx", "定量比较"], "level": "专家"}, {"id": "bio-chipseq-super-enhancers", "title_zh": "超级增强子鉴定", "summary_zh": "从 H3K27ac 等标记的 ChIP-seq 数据中识别超级增强子，这些区域对细胞身份和疾病至关重要，可用于构建调控网络。", "domain": "表观与调控", "subcategory": "ChIP-seq 与组蛋白", "tags_zh": ["超级增强子", "H3K27ac", "ROSE", "调控网络"], "level": "进阶"}, {"id": "bio-clinical-biostatistics-adaptive-designs", "title_zh": "适应性临床试验设计", "summary_zh": "设计可根据中期数据调整的临床试验，如修改样本量或治疗组，提高效率，同时遵循 FDA 指南，适用于药物研发。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["适应性设计", "期中分析", "样本量调整", "FDA"], "level": "专家"}, {"id": "bio-clinical-biostatistics-bayesian-trials", "title_zh": "贝叶斯临床试验设计", "summary_zh": "使用贝叶斯方法设计临床试验，如剂量探索和篮子试验，可整合先验信息，灵活决策，适用于早期临床研究。", "domain": "临床与医学", "subcategory": "肿瘤与癌症基因组", "tags_zh": ["贝叶斯", "剂量探索", "篮子试验", "先验信息"], "level": "专家"}]