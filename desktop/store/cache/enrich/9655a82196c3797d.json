[{"id": "bio-sashimi-plots", "title_zh": "绘制剪接可视化图", "summary_zh": "用多种工具绘制RNA-seq剪接事件的可视化图，展示外显子覆盖度和剪接连接数，适合论文发表和结果展示。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["剪接可视化", "RNA-seq", "论文图表"], "level": "入门"}, {"id": "bio-single-cell-splicing", "title_zh": "单细胞剪接分析", "summary_zh": "在单细胞水平分析可变剪接，需根据文库类型选择合适方法，全长度或长读长测序可获得更准确的异构体信息。", "domain": "单细胞与空间", "subcategory": "单细胞多组学", "tags_zh": ["单细胞", "可变剪接", "异构体"], "level": "进阶"}, {"id": "bio-splice-variant-prediction", "title_zh": "预测变异对剪接的影响", "summary_zh": "用深度学习工具预测DNA变异是否影响mRNA剪接，帮助解读基因组变异的功能意义，尤其适用于临床诊断。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["剪接预测", "变异注释", "深度学习"], "level": "进阶"}, {"id": "bio-splicing-qc", "title_zh": "剪接分析数据质控", "summary_zh": "评估RNA-seq数据用于剪接分析的质量，包括比对、剪接位点强度等，确保后续剪接定量可靠。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["质控", "剪接", "RNA-seq"], "level": "进阶"}, {"id": "bio-splicing-quantification", "title_zh": "剪接定量分析", "summary_zh": "从RNA-seq数据计算剪接事件的PSI值，比较不同条件下的剪接差异，常用工具包括rMATS、SUPPA2等。", "domain": "转录组与表达", "subcategory": "可变剪接与异构体", "tags_zh": ["剪接定量", "PSI", "差异剪接"], "level": "进阶"}, {"id": "bio-atac-seq-allele-specific-accessibility", "title_zh": "等位基因特异性染色质可及性分析", "summary_zh": "检测ATAC-seq中不同等位基因的染色质开放差异，用于定位顺式调控变异，需注意参考等位基因偏差校正。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["等位基因", "染色质可及性", "ATAC-seq"], "level": "专家"}, {"id": "bio-atac-seq-atac-peak-calling", "title_zh": "ATAC-seq峰识别", "summary_zh": "从ATAC-seq比对文件中识别开放染色质区域（峰），常用MACS3等工具，需进行IDR分析确保峰的可重复性。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["峰识别", "ATAC-seq", "开放染色质"], "level": "进阶"}, {"id": "bio-atac-seq-atac-qc", "title_zh": "ATAC-seq文库质控", "summary_zh": "评估ATAC-seq文库质量，包括TSS富集、片段周期性等指标，判断是否达到ENCODE标准，决定是否继续下游分析。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["质控", "ATAC-seq", "ENCODE标准"], "level": "进阶"}, {"id": "bio-atac-seq-co-accessibility", "title_zh": "染色质共可及性分析", "summary_zh": "从单细胞ATAC-seq推断增强子与启动子之间的调控连接，无需配对RNA数据，可用于构建基因调控网络。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["共可及性", "增强子-启动子", "单细胞ATAC"], "level": "专家"}, {"id": "bio-atac-seq-consensus-peakset", "title_zh": "构建共识峰集", "summary_zh": "将多个重复样本的ATAC-seq峰合并成统一的峰集，用于下游差异分析，确保峰坐标一致可比。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["共识峰", "ATAC-seq", "差异分析"], "level": "进阶"}, {"id": "bio-atac-seq-deep-learning-atac", "title_zh": "深度学习预测染色质可及性", "summary_zh": "用深度学习模型从DNA序列预测ATAC-seq信号，可校正Tn5偏差、评估变异效应、发现调控基序。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["深度学习", "染色质可及性", "序列预测"], "level": "专家"}, {"id": "bio-atac-seq-differential-accessibility", "title_zh": "差异染色质可及性分析", "summary_zh": "比较不同条件下ATAC-seq的染色质开放差异，识别差异开放区域，常用DiffBind、DESeq2等工具。", "domain": "表观与调控", "subcategory": "ATAC / 染色质可及性", "tags_zh": ["差异分析", "染色质可及性", "ATAC-seq"], "level": "进阶"}]