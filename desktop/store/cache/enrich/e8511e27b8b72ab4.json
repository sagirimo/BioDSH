[{"id": "tblastn-search", "title_zh": "TBLASTN 蛋白序列搜索", "summary_zh": "用一段蛋白序列在核酸数据库中搜索相似序列，常用于寻找同源基因或验证预测的蛋白编码区。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["序列比对", "同源搜索", "数据库"], "level": "入门"}, {"id": "tblastx-search", "title_zh": "TBLASTX 翻译序列搜索", "summary_zh": "将核酸序列翻译成蛋白后再比对，用于寻找远缘同源序列，适合分析新测序基因组或转录组。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["序列比对", "同源搜索", "数据库"], "level": "入门"}, {"id": "trinity-assemble", "title_zh": "Trinity 转录组组装", "summary_zh": "用 Trinity 软件从 RNA-seq 数据从头组装转录本，无需参考基因组，适用于非模式物种或研究新转录本。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["转录组", "从头组装", "RNA-seq"], "level": "进阶"}, {"id": "varscan-call", "title_zh": "VarScan2 变异检测", "summary_zh": "从比对好的 BAM 文件中检测生殖系变异（如 SNP 和 InDel），适用于全外显子或靶向测序数据。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["变异检测", "SNP", "InDel"], "level": "进阶"}, {"id": "vep-annotate", "title_zh": "VEP 变异注释", "summary_zh": "用 Ensembl VEP 对变异位点进行功能注释，告诉你变异影响哪个基因、是否改变蛋白等，帮助解读变异意义。", "domain": "基因组与变异", "subcategory": "变异检测与注释", "tags_zh": ["变异注释", "功能预测", "数据库"], "level": "进阶"}, {"id": "instrument-data-to-allotrope", "title_zh": "仪器数据转 Allotrope 格式", "summary_zh": "将实验室仪器输出的 PDF、Excel 等文件转换为标准化的 Allotrope 格式，方便导入 LIMS 或数据湖，实现数据统一管理。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["数据标准化", "仪器数据", "格式转换"], "level": "进阶"}, {"id": "nextflow-development", "title_zh": "Nextflow 流程配置与启动", "summary_zh": "为 nf-core 流程准备样本表、配置集群参数并生成运行脚本，简化 Nextflow 管道的启动过程，适合标准化分析。", "domain": "数据与工具", "subcategory": "流程与环境", "tags_zh": ["Nextflow", "流程管理", "集群配置"], "level": "进阶"}, {"id": "scvi-tools", "title_zh": "scvi-tools 深度整合模型", "summary_zh": "训练 scVI、scANVI 等深度模型，用于单细胞数据的批次整合和下游分析，比传统方法更能处理复杂数据。", "domain": "单细胞与空间", "subcategory": "单细胞多组学", "tags_zh": ["单细胞", "批次整合", "深度学习"], "level": "专家"}, {"id": "single-cell-rna-qc", "title_zh": "单细胞 RNA 质控与预处理", "summary_zh": "对单细胞 RNA 测序数据进行质控、标准化、降维聚类和差异表达分析，得到细胞群和标记基因，但不做细胞类型注释。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "