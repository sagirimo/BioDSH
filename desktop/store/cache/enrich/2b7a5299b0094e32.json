ERO 服务器，读取和管理生物图像数据，添加注释和感兴趣区域，方便批量分析。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["图像管理", "数据库", "Python"], "level": "进阶"}, {"id": "pathml", "title_zh": "PathML 病理图像分析", "summary_zh": "处理全切片病理图像，包括提取图块、染色归一化、细胞核分割和特征提取，支持机器学习建模。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["病理图像", "特征提取", "机器学习"], "level": "进阶"}, {"id": "pydicom-medical-imaging", "title_zh": "DICOM 医学影像读写", "summary_zh": "用 Python 读写 DICOM 格式的医学影像（CT、MRI等），提取像素数据、修改标签、匿名化，并转换为三维体积。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["DICOM", "医学影像", "图像处理"], "level": "进阶"}, {"id": "simpleitk-image-registration", "title_zh": "SimpleITK 图像配准分割", "summary_zh": "对三维医学图像进行配准、分割和滤波，如对齐不同时间点的扫描，或分割荧光信号，支持多种格式。", "domain": "代谢与其他组学", "subcategory": "影像与显微", "tags_zh": ["图像配准", "分割", "医学影像"], "level": "进阶"}]