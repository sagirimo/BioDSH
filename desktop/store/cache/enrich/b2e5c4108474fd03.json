[{"id": "biocontext-knowledge-queries", "title_zh": "基因注释与知识库查询", "summary_zh": "当你想了解一个基因的功能、参与的生物过程或相关疾病时，用它查询多个权威数据库，快速获得综合注释信息。", "domain": "数据与工具", "subcategory": "公共数据库查询", "tags_zh": ["基因注释", "数据库", "功能查询"], "level": "入门"}, {"id": "bulk-rna-seq-batch-correction-with-combat", "title_zh": "批量RNA测序批次效应校正", "summary_zh": "当合并多个批次的RNA测序数据时，用它去除批次差异，让数据可比，并输出校正后的矩阵和可视化结果。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["批次校正", "数据整合", "RNA-seq"], "level": "进阶"}, {"id": "bulk-rna-seq-differential-expression-with-omicve", "title_zh": "批量RNA测序差异表达分析", "summary_zh": "当你想找出两组样本中表达水平显著变化的基因时，用它进行标准化、统计检验，并生成火山图和通路富集结果。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["差异表达", "DESeq2", "通路富集"], "level": "进阶"}, {"id": "bulk-rna-seq-deseq2-analysis-with-omicverse", "title_zh": "DESeq2差异表达与富集分析", "summary_zh": "当你想用DESeq2方法分析RNA测序数据时，用它进行基因ID转换、差异检验、筛选显著基因，并做GSEA富集分析。", "domain": "转录组与表达", "subcategory": "差异表达", "tags_zh": ["DESeq2", "差异表达", "GSEA"], "level": "进阶"}, {"id": "string-protein-interaction-analysis-with-omicver", "title_zh": "STRING蛋白互作网络分析", "summary_zh": "当你想了解一组基因编码的蛋白质之间的相互作用时，用它查询STRING数据库，构建并可视化蛋白互作网络。", "domain": "蛋白与结构", "subcategory": "蛋白互作", "tags_zh": ["蛋白互作", "网络分析", "STRING"], "level": "进阶"}, {"id": "bulk-rna-seq-deconvolution-with-bulk2single", "title_zh": "批量RNA测序细胞类型解卷积", "summary_zh": "当你的样本是混合组织，想估计其中不同细胞类型的比例时，用它把批量数据转换成模拟单细胞数据，并估算细胞比例。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["细胞比例", "解卷积", "单细胞模拟"], "level": "专家"}, {"id": "bulktrajblend-trajectory-interpolation", "title_zh": "批量数据补充发育轨迹", "summary_zh": "当你的单细胞轨迹缺少中间状态时，用它结合批量RNA测序数据，生成中间细胞，填补轨迹空白。", "domain": "单细胞与空间", "subcategory": "轨迹与动态", "tags_zh": ["轨迹推断", "数据填补", "发育"], "level": "专家"}, {"id": "bulk-wgcna-analysis-with-omicverse", "title_zh": "WGCNA共表达网络分析", "summary_zh": "当你想找出共表达的基因模块，并关联样本性状时，用它构建加权基因共表达网络，识别关键模块和核心基因。", "domain": "转录组与表达", "subcategory": "共表达与网络", "tags_zh": ["共表达", "WGCNA", "模块分析"], "level": "进阶"}, {"id": "data-export-excel", "title_zh": "导出Excel表格文件", "summary_zh": "当你想把分析结果或数据表格保存为Excel文件时，用它轻松生成格式化的电子表格，方便分享和后续处理。", "domain": "数据与工具", "subcategory": "数据格式与转换", "tags_zh": ["Excel", "数据导出", "表格"], "level": "入门"}, {"id": "data-export-pdf", "title_zh": "生成PDF报告文档", "summary_zh": "当你想把分析结果整理成专业报告时，用它创建包含文字、表格和图片的PDF文件，便于打印和分发。", "domain": "数据与工具", "subcategory": "写作与报告", "tags_zh": ["PDF", "报告", "文档生成"], "level": "入门"}, {"id": "data-io-loading", "title_zh": "读取多种单细胞数据格式", "summary_zh": "当你想导入单细胞或空间转录组数据时，用它读取10x、h5ad、Visium等多种格式，方便后续分析。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "tags_zh": ["数据读取", "单细胞", "格式转换"], "level": "入门"}, {"id": "data-stats-analysis", "title_zh": "统计检验与相关性分析", "summary_zh": "当你想验证数据差异是否显著或变量间是否相关时，用它进行假设检验、相关分析和多重校正。", "domain": "数据与工具", "subcategory": "统计与机器学习", "tags_zh": ["统计检验", "相关性", "假设检验"], "level": "进阶"}]