[{"id": "bio-read-qc-adapter-trimming", "title_zh": "去除测序接头序列", "summary_zh": "当测序数据中混入接头序列时，用此方法将其切除，得到干净的序列，用于后续分析。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["接头去除", "数据清洗", "质控"], "level": "入门"}, {"id": "bio-read-qc-contamination-screening", "title_zh": "检测测序数据污染", "summary_zh": "当怀疑测序数据混入其他物种或样本的序列时，用此方法识别并评估污染程度，决定是否过滤或重新比对。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["污染检测", "样本混淆", "质控"], "level": "进阶"}, {"id": "bio-read-qc-fastp-workflow", "title_zh": "一站式测序数据预处理", "summary_zh": "用fastp工具一次性完成接头去除、质量过滤等步骤，并生成报告，适合批量处理Illumina测序数据。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["数据预处理", "fastp", "自动化"], "level": "入门"}, {"id": "bio-read-qc-quality-filtering", "title_zh": "按质量过滤测序读段", "summary_zh": "当测序读段质量参差不齐时，用此方法过滤掉低质量、短或含N的读段，提高后续分析准确性。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["质量过滤", "数据清洗", "质控"], "level": "入门"}, {"id": "bio-read-qc-quality-reports", "title_zh": "生成测序质量报告", "summary_zh": "用FastQC等工具生成测序数据的质量报告，帮助判断数据好坏，发现异常样本或批次效应。", "domain": "基因组与变异", "subcategory": "测序质控与比对", "tags_zh": ["质量报告", "FastQC", "质控"], "level": "入门"}, {"id": "bio-read-qc-rnaseq-qc", "title_zh": "RNA测序数据质控", "summary_zh": "针对RNA测序数据，检查链特异性、基因覆盖度、核糖体RNA污染等，确保数据质量可靠。", "domain": "转录组与表达", "subcategory": "RNA-seq 上游处理", "tags_zh": ["RNA-seq", "质控", "数据评估"], "level": "进阶"}, {"id": "bio-read-qc-umi-processing", "title_zh": "处理UMI分子标签", "summary_zh": "当测序数据带有UMI标签时，用此方法提取并校正，去除重复，准确计数原始分子，用于单细胞或低频突变检测。", "domain": "单细胞与空间", "subcategory": "单细胞预处理与质控", "tags_zh": ["UMI", "去重", "单细胞"], "level": "进阶"}, {"id": "bio-reporting-automated-qc-reports", "title_zh": "汇总自动化质控报告", "summary_zh": "将多个样本的质控结果汇总成一个交互式报告，方便查看整体质量，并可作为自动化的质控门槛。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["MultiQC", "质控报告", "自动化"], "level": "入门"}, {"id": "bio-reporting-figure-export", "title_zh": "导出出版级图表", "summary_zh": "将图表导出为适合期刊发表的格式，确保字体、颜色、分辨率符合要求，避免投稿时被退回。", "domain": "数据与工具", "subcategory": "可视化与作图", "tags_zh": ["出版图表", "导出", "期刊要求"], "level": "进阶"}, {"id": "bio-reporting-jupyter-reports", "title_zh": "生成可复现的Jupyter报告", "summary_zh": "用参数化Jupyter笔记本批量生成分析报告，并转换为HTML或PDF，确保结果可复现。", "domain": "数据与工具", "subcategory": "写作与报告", "tags_zh": ["Jupyter", "报告生成", "可复现"], "level": "进阶"}, {"id": "bio-reporting-publication-tables", "title_zh": "制作出版级统计表格", "summary_zh": "用R或Python工具制作论文中常用的统计表格，如基线特征表、回归结果表，并导出为合适格式。", "domain": "数据与工具", "subcategory": "写作与报告", "tags_zh": ["统计表格", "论文写作", "格式化"], "level": "进阶"}, {"id": "bio-reporting-quarto-reports", "title_zh": "创建可复现的Quarto报告", "summary_zh": "用Quarto创建包含代码、结果和叙述的报告或演示文稿，支持多种语言，确保分析可复现。", "domain": "数据与工具", "subcategory": "写作与报告", "tags_zh": ["Quarto", "报告", "可复现"], "level": "进阶"}]