{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BioDSH",
  "version": "0.2.3",
  "identifier": "org.biodsh.desktop",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --config vite.tauri.config.ts",
    "beforeBuildCommand": "npx vite build --config vite.tauri.config.ts"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Medical",
    "shortDescription": "BioDSH 生信智能体桌面版",
    "resources": {
      "../resources/skills": "skills",
      "../resources/demos": "demos",
      "../resources/scripts": "scripts",
      "../resources/community-skills": "community-skills",
      "../resources/bioenv": "bioenv",
      "../dsh-runtime/node_modules": "dsh/node_modules"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RjAzNjIxNEFBMEFDMDAKUldRQXJLQktJVGJ3T0ZVWlg5S3Vhb29LZ3crTmpDcGsrRGpzYzdwSjZVT2FNa1ZHcXlsaWFXc3gK",
      "endpoints": [
        "https://github.com/sagirimo/BioDSH/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
