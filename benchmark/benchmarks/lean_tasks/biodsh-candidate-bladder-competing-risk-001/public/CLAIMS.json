      "type": "number",
      "question": "MIBC人数",
      "binding": {
        "table": "cohort_summary.csv",
        "key_column": "group",
        "key": "MIBC",
        "column": "n"
      },
      "rel_tol": 1e-06,
      "abs_tol": 1e-08
    },
    {
