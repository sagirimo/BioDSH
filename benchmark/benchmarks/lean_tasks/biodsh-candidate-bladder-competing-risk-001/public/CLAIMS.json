      "rel_tol": 1e-06,
      "abs_tol": 1e-08
    },
    {
      "id": "other_NMIBC",
      "type": "number",
      "question": "NMIBC其他死亡数",
      "binding": {
        "table": "cohort_summary.csv",
        "key_column": "group",
        "key": "NMIBC",
        "column": "other_deaths"
      },
      "rel_tol": 1e-06,
      "abs_tol": 1e-08
    },
    {
