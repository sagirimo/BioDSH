{
  "revision": "round5_lean_v1",
  "task_id": "biodsh-candidate-adenylate-domain-rigid-motion-001",
  "claims": [
    {
      "id": "N1",
      "type": "number",
      "question": "核心对齐后LID的RMSD？",
      "binding": {
        "table": "domain_motion.csv",
        "key_column": "id",
        "key": "core|LID",
        "column": "global_rmsd_A"
      },
      "rel_tol": 1e-05,
      "abs_tol": 1e-08
    },
    {
      "id": "N2",
      "type": "number",
      "question": "LID内部刚体对齐后的RMSD？",
      "binding": {
        "table": "domain_motion.csv",
        "key_column": "id",
        "key": "core|LID",
        "column": "local_rmsd_A"
      },
      "rel_tol": 1e-05,
      "abs_tol": 1e-08
    },
    {
      "id": "N3",
      "type": "number",
      "question": "LID相对旋转角？",
      "binding": {
        "table": "domain_motion.csv",
        "key_column": "id",
        "key": "core|LID",
        "column": "relative_rotation_deg"
      },
      "rel_tol": 1e-05,
      "abs_tol": 1e-08
    },
    {
      "id": "N4",
      "type": "number",
      "question": "NMP相对旋转角？",
      "binding": {
        "table": "domain_motion.csv",
        "key_column": "id",
        "key": "core|NMP",
        "column": "relative_rotation_deg"
      },
      "rel_tol": 1e-05,
      "abs_tol": 1e-08
    },
    {
      "id": "N5",
      "type": "number",
      "question": "核心对齐后大位移残基数？",
      "binding": {
        "table": "alignment_summary.csv",
        "key_column": "id",
        "key": "core",
        "column": "above_5A"
      },
      "rel_tol": 1e-05,
      "abs_tol": 1e-08
    },
    {
      "id": "N6",
      "type": "number",
      "question": "LID对齐选择敏感性？",
      "binding": {
        "table": "alignment_sensitivity.csv",
        "key_column": "id",
        "key": "LID",
        "column": "delta_global_rmsd_A"
      },
      "rel_tol": 1e-05,
      "abs_tol": 1e-08
    },
    {
      "id": "D1",
      "type": "derived",
      "question": "LID相对旋转是否超过30度？",
      "options": [
        "yes",
        "no"
      ],
      "rule": {
        "binding": {
          "table": "domain_motion.csv",
          "key_column": "id",
          "key": "core|LID",
          "column": "relative_rotation_deg"
        },
        "op": "gt",
        "threshold": 30,
        "outcomes": {
          "true": "yes",
          "false": "no"
        }
      }
    },
    {
      "id": "D2",
      "type": "derived",
      "question": "LID域内RMSD是否小于2Å？",
      "options": [
        "yes",
        "no"
      ],
      "rule": {
        "binding": {
          "table": "domain_motion.csv",
          "key_column": "id",
          "key": "core|LID",
          "column": "local_rmsd_A"
        },
        "op": "lt",
        "threshold": 2,
        "outcomes": {
          "true": "yes",
          "false": "no"
        }
      }
    },
    {
      "id": "scope",
      "type": "choice",
      "question": "两结构域运动分解支持什么？",
      "options": [
        "这两个晶体模型之间存在依赖参照系的结构域位移，不能确定真实动力学路径",
        "可直接得到闭合速率常数",
        "全体对齐后残基位移完全不受拟合区域影响"
      ]
    }
  ]
}
