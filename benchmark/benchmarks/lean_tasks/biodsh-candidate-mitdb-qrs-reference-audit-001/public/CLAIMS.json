    {
      "id": "detector_quality",
      "type": "derived",
      "question": "该窗F1是否达到0.95？",
      "options": [
        "f1_at_least_0_95",
        "f1_below_0_95"
      ],
      "rule": {
        "binding": {
          "table": "detection.csv",
          "key_column": "id",
          "key": "all",
          "column": "f1"
        },
        "op": "ge",
        "threshold": 0.95,
        "outcomes": {
          "true": "f1_at_least_0_95",
          "false": "f1_below_0_95"
        }
      }
    },
    {
      "id": "rate_level",
      "type": "derived",
      "question": "平均检测心率是否超过100次/分？",
      "options": [
        "above_100",
        "at_most_100"
      ],
      "rule": {
        "binding": {
          "table": "interval_summary.csv",
          "key_column": "id",
          "key": "detected",
          "column": "mean_rate_bpm"
        },
        "op": "gt",
        "threshold": 100,
        "outcomes": {
          "true": "above_100",
          "false": "at_most_100"
        }
      }
    },
    {
      "id": "scope",
      "type": "choice",
      "question": "参考NN与检测RR的区别是什么？",
      "options": [
