      "rule": {
        "binding": {
          "table": "model_coefficients.csv",
          "key_column": "row_id",
          "key": "original|marker_adjusted|marker",
          "column": "p_value"
        },
        "op": "lt",
        "threshold": 0.05,
        "outcomes": {
