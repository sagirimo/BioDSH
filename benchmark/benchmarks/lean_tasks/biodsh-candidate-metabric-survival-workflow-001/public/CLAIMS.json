        "op": "gt",
        "threshold": 1,
        "outcomes": {
          "true": "higher_NPI_associated_higher_hazard",
          "false": "higher_NPI_not_higher_hazard"
        }
      }
    },
    {
      "id": "NPI_evidence",
      "type": "derived",
