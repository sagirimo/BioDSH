        "key_set": {
          "branches": [
            {
              "values": [
                "IVW_GLS",
                "IVW_ignoring_LD"
              ],
              "then": {
                "cartesian": [
                  [
                    "calcium"
                  ],
                  [
                    "calcium"
                  ],
                  {
                    "integer_range": [
                      1,
                      6
                    ],
                    "prefix": "omit_v",
                    "suffix": "",
                    "zero_pad": 3
                  }
                ]
              }
            },
            {
              "values": [
                "Egger_GLS"
              ],
              "then": {
                "cartesian": [
                  [
                    "calcium"
                  ],
                  [
                    "calcium",
                    "intercept"
                  ],
                  {
                    "integer_range": [
                      1,
                      6
                    ],
                    "prefix": "omit_v",
                    "suffix": "",
                    "zero_pad": 3
                  }
                ]
              }
            }
          ]
        },
        "composite_key": {
          "column": "fit_id",
          "join": "|",
          "rule": "展开key_set得到的各分量按join原样连接成唯一键；不对分量作数值重写。"
        }
